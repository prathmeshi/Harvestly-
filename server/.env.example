PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Create an account on https://data.gov.in/ and generate an API key.
# Find the resource ID for the Current Daily Price of Various Commodities from Various Markets (Mandi) dataset.
# Keep credentials on the backend only. Do not add .env to Git.
DATA_GOV_API_KEY=replace_with_your_data_gov_in_api_key
DATA_GOV_MARKET_RESOURCE_ID=replace_with_market_price_resource_id
